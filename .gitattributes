# Fins de ligne normalisees en LF dans le depot.
* text=auto eol=lf

# Le lanceur Windows doit rester en CRLF.
*.bat text eol=crlf

# Les lanceurs shell doivent rester en LF : un shebang suivi de \r casse l'execution.
*.command text eol=lf
*.sh      text eol=lf

# Binaires : aucune conversion.
*.woff2 binary
*.zip   binary
*.ico   binary
*.png   binary
